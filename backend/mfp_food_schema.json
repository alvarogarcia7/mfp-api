{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MFP Food Fact Schema",
  "description": "Schema for raw food data from MyFitnessPal API",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Food item name with brand and package size",
      "minLength": 1,
      "maxLength": 500
    },
    "measurement": {
      "type": "object",
      "description": "Standard measurement for this food",
      "properties": {
        "unit": {
          "type": "string",
          "description": "Measurement unit (g or ml)",
          "enum": ["g", "ml"]
        },
        "value": {
          "type": "number",
          "description": "Measurement value",
          "minimum": 0.1,
          "maximum": 10000
        }
      },
      "required": ["unit", "value"],
      "additionalProperties": false
    },
    "calories": {
      "type": "number",
      "description": "Calories per measurement unit",
      "minimum": 0,
      "maximum": 1000000
    },
    "protein": {
      "type": "number",
      "description": "Protein in grams",
      "minimum": 0,
      "maximum": 1000
    },
    "carbohydrates": {
      "type": "number",
      "description": "Carbohydrates in grams (raw MFP field name)",
      "minimum": 0,
      "maximum": 1000
    },
    "fat": {
      "type": "number",
      "description": "Fat in grams",
      "minimum": 0,
      "maximum": 1000
    },
    "fiber": {
      "type": "number",
      "description": "Dietary fiber in grams",
      "minimum": 0,
      "maximum": 1000
    },
    "sugar": {
      "type": "number",
      "description": "Sugar in grams",
      "minimum": 0,
      "maximum": 1000
    },
    "sodium": {
      "type": "number",
      "description": "Sodium in milligrams",
      "minimum": 0,
      "maximum": 1000000
    },
    "cholesterol": {
      "type": "number",
      "description": "Cholesterol in milligrams",
      "minimum": 0,
      "maximum": 1000
    },
    "saturated_fat": {
      "type": "number",
      "description": "Saturated fat in grams",
      "minimum": 0,
      "maximum": 1000
    },
    "potassium": {
      "type": "number",
      "description": "Potassium in milligrams",
      "minimum": 0,
      "maximum": 1000000
    }
  },
  "required": ["name", "measurement", "calories", "protein", "carbohydrates", "fat", "fiber", "sugar", "sodium", "cholesterol", "saturated_fat", "potassium"],
  "additionalProperties": true
}

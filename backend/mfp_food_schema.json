{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MFP Food Fact Schema",
  "description": "Schema for raw food data from MyFitnessPal API",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Food item name with brand and package size",
      "minLength": 1,
      "maxLength": 500
    },
    "measurement": {
      "type": "object",
      "description": "Raw measurement from MFP API (unprocessed)",
      "properties": {
        "unit": {
          "type": ["string", "null"],
          "description": "Measurement unit as returned by MFP (any unit string)"
        },
        "value": {
          "type": ["number", "null"],
          "description": "Measurement value (numeric or missing)"
        }
      },
      "required": ["unit", "value"],
      "additionalProperties": false
    },
    "calories": {
      "type": "number",
      "description": "Calories per measurement unit",
      "minimum": 0,
      "maximum": 1000000
    },
    "protein": {
      "type": "number",
      "description": "Protein in grams",
      "minimum": 0,
      "maximum": 1000
    },
    "carbohydrates": {
      "type": "number",
      "description": "Carbohydrates in grams (raw MFP field name)",
      "minimum": 0,
      "maximum": 1000
    },
    "fat": {
      "type": "number",
      "description": "Fat in grams",
      "minimum": 0,
      "maximum": 1000
    },
    "fiber": {
      "type": "number",
      "description": "Dietary fiber in grams",
      "minimum": 0,
      "maximum": 1000
    },
    "sugar": {
      "type": "number",
      "description": "Sugar in grams",
      "minimum": 0,
      "maximum": 1000
    },
    "sodium": {
      "type": "number",
      "description": "Sodium in milligrams",
      "minimum": 0,
      "maximum": 1000000
    },
    "cholesterol": {
      "type": "number",
      "description": "Cholesterol in milligrams",
      "minimum": 0,
      "maximum": 1000
    },
    "saturated_fat": {
      "type": "number",
      "description": "Saturated fat in grams",
      "minimum": 0,
      "maximum": 1000
    },
    "potassium": {
      "type": "number",
      "description": "Potassium in milligrams",
      "minimum": 0,
      "maximum": 1000000
    },
    "download_url": {
      "type": ["string", "null"],
      "description": "MyFitnessPal download URL for this food"
    },
    "measurement_unit_url": {
      "type": ["string", "null"],
      "description": "MyFitnessPal URL for the measurement unit"
    },
    "raw": {
      "type": ["object", "null"],
      "description": "Raw MFP entry data (unprocessed)",
      "additionalProperties": true
    }
  },
  "required": ["name", "measurement", "calories", "protein", "carbohydrates", "fat", "fiber", "sugar", "sodium", "cholesterol", "saturated_fat", "potassium"],
  "additionalProperties": true
}

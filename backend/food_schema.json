{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Food Cache Schema",
  "description": "Schema for food items in the local cache database",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Food item name with brand and package size",
      "minLength": 1,
      "maxLength": 500
    },
    "measurement": {
      "type": "object",
      "description": "Standard measurement for this food",
      "properties": {
        "unit": {
          "type": "string",
          "description": "Measurement unit (g or ml)",
          "enum": ["g", "ml"]
        },
        "value": {
          "type": "number",
          "description": "Measurement value",
          "minimum": 0.1,
          "maximum": 10000
        }
      },
      "required": ["unit", "value"],
      "additionalProperties": false
    },
    "calories": {
      "type": "number",
      "description": "Calories per measurement unit",
      "minimum": 0,
      "maximum": 1000000
    },
    "protein": {
      "type": "number",
      "description": "Protein in grams",
      "minimum": 0,
      "maximum": 1000
    },
    "carbs": {
      "type": "number",
      "description": "Carbohydrates in grams",
      "minimum": 0,
      "maximum": 1000
    },
    "fat": {
      "type": "number",
      "description": "Fat in grams",
      "minimum": 0,
      "maximum": 1000
    },
    "fiber": {
      "type": "number",
      "description": "Dietary fiber in grams",
      "minimum": 0,
      "maximum": 1000
    },
    "sugar": {
      "type": "number",
      "description": "Sugar in grams",
      "minimum": 0,
      "maximum": 1000
    },
    "sodium": {
      "type": "number",
      "description": "Sodium in milligrams",
      "minimum": 0,
      "maximum": 1000000
    },
    "cholesterol": {
      "type": "number",
      "description": "Cholesterol in milligrams",
      "minimum": 0,
      "maximum": 1000
    },
    "saturated_fat": {
      "type": "number",
      "description": "Saturated fat in grams",
      "minimum": 0,
      "maximum": 1000
    },
    "potassium": {
      "type": "number",
      "description": "Potassium in milligrams",
      "minimum": 0,
      "maximum": 1000000
    },
    "food_id": {
      "type": ["string", "null"],
      "description": "MyFitnessPal food ID for API lookups",
      "minLength": 1,
      "maxLength": 100
    },
    "weight_id": {
      "type": ["string", "null"],
      "description": "MyFitnessPal weight ID for API lookups",
      "minLength": 1,
      "maxLength": 100
    },
    "brand": {
      "type": ["string", "null"],
      "description": "Brand name if applicable",
      "maxLength": 500
    },
    "verified": {
      "type": ["boolean", "null"],
      "description": "Whether the food data is verified by MyFitnessPal"
    },
    "serving": {
      "type": ["string", "null"],
      "description": "Serving size description",
      "maxLength": 200
    }
  },
  "required": ["name", "measurement", "calories", "protein", "carbs", "fat", "fiber", "sugar", "sodium", "cholesterol", "saturated_fat", "potassium"],
  "additionalProperties": false
}

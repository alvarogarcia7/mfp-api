{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Exercise Schema",
  "description": "Schema for validating exercise entries",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "description": "Exercise date in YYYY-MM-DD format",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "name": {
      "type": "string",
      "description": "Exercise name or sport type",
      "minLength": 1,
      "maxLength": 100
    },
    "calories": {
      "type": "integer",
      "description": "Active calories burned",
      "minimum": 1,
      "maximum": 10000
    },
    "duration": {
      "type": "integer",
      "description": "Exercise duration in minutes",
      "minimum": 1,
      "maximum": 1440
    },
    "distance": {
      "type": "number",
      "description": "Distance covered in kilometers",
      "minimum": 0,
      "maximum": 1000,
      "default": 0
    },
    "heart_rate": {
      "type": "object",
      "description": "Heart rate data during exercise",
      "properties": {
        "average": {
          "type": "integer",
          "description": "Average heart rate in BPM",
          "minimum": 30,
          "maximum": 250
        },
        "max": {
          "type": "integer",
          "description": "Maximum heart rate in BPM",
          "minimum": 30,
          "maximum": 250
        },
        "min": {
          "type": "integer",
          "description": "Minimum heart rate in BPM",
          "minimum": 30,
          "maximum": 250
        }
      }
    },
    "sport_id": {
      "type": "string",
      "description": "Sport type identifier",
      "enum": ["HIIT", "Padel", "Running", "Lifting", "Walking", "Cycling", "Swimming", "Other"]
    },
    "created_at": {
      "type": "string",
      "description": "ISO 8601 timestamp when exercise was created",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "description": "Data source (manual, polar_flow, etc)",
      "enum": ["manual", "polar_flow", "imported"],
      "default": "manual"
    }
  },
  "required": ["date", "name", "calories", "duration"],
  "additionalProperties": false
}

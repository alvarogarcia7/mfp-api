# MyFitnessPal (MFP) Credentials
# REQUIRED: Either username/password OR session cookie

# MFP username or email
MFP_USERNAME=your_email@example.com

# MFP session cookie (alternative to username/password)
# To get this:
# 1. Log in to https://www.myfitnesspal.com
# 2. Open DevTools (F12) → Application/Storage → Cookies
# 3. Find __Secure-next-auth.session-token
# 4. Copy the value here
MFP_SESSION_COOKIE=your_session_token_here

# MFP Cardio Activity Default Settings
# Exercise ID for "Cardio" or similar activity type in MFP
# (Optional - defaults to generic cardio)
MFP_CARDIO_EXERCISE_ID=

# MyFitnessPal auto-sync enabled
# Set to true to automatically sync Polar Flow activities to MFP on app start
MFP_AUTO_SYNC_ACTIVITIES=false

# Polar Flow Integration
# Get these credentials by logging into https://flow.polar.com/

# Polar Flow username
POLAR_FLOW_USERNAME=your_username

# Polar Flow User ID (REQUIRED for API calls)
# To get this:
# 1. Log in to https://flow.polar.com/
# 2. Open DevTools (F12) → Network tab
# 3. Go to Training List or any page
# 4. Look for a POST request to /api/training/history
# 5. In the request body, find "userId": 12345678 (that's your user ID)
# Alternatively, check the browser console after any API call
POLAR_FLOW_USER_ID=your_user_id_here

# Polar Flow session cookie (REQUIRED - Extracted from .env.polar.request.* file)
# DO NOT manually edit this - it will be automatically extracted from a curl request
# To extract the cookie:
# 1. Log in to https://flow.polar.com/
# 2. Open DevTools (F12) → Network tab
# 3. Find a successful API request to /api/training/* or similar
# 4. Right-click → Copy as cURL → Copy the full curl command
# 5. Paste into .env.polar.request.local
# 6. Run: python -m backend.polar.extract_cookie .env.polar.request.local
# 7. The cookie will be extracted and displayed (add it here or run with --auto-update)
POLAR_FLOW_COOKIE=

